.setItem('selectedHue', hue);\n    setIsOpen(false);\n  };\n\n  return (\n    <div className=\"color-palette\">\n      {isOpen && (\n        <div className=\"color-palette__menu\">\n          {colors.map((color) => (\n            <button\n              key={color.hue}\n              className=\"color-palette__item\"\n              style={{ backgroundColor: color.hex }}\n              onClick={() => changeColor(color.hue)}\n              title={color.name}\n            >\n              <span className=\"color-palette__tooltip\">{color.name}</span>\n            </button>\n          ))}\n        </div>\n      )}\n    </div>\n  );\n}\n\nexport default ColorPalette;\n"],"mappings":"AAAA,MAAO,CAAAA,KAAK,EAAIC,QAAQ,KAAQ,OAAO,CAAC,OAAAC,GAAA,IAAAC,IAAA,yBAExC,QAAS,CAAAC,YAAYA,CAAA,CAAG,CACtB,KAAM,CAACC,MAAM,CAAEC,SAAS,CAAC,CAAGL,QAAQ,CAAC,KAAK,CAAC,CAE3C,KAAM,CAAAM,MAAM,CAAG,CACb,CAAEC,IAAI,CAAE,MAAM,CAAEC,GAAG,CAAE,GAAG,CAAEC,GAAG,CAAE,SAAU,CAAC,CAC1C,CAAEF,IAAI,CAAE,MAAM,CAAEC,GAAG,CAAE,GAAG,CAAEC,GAAG,CAAE,SAAU,CAAC,CAC1C,CAAEF,IAAI,CAAE,OAAO,CAAEC,GAAG,CAAE,GAAG,CAAEC,GAAG,CAAE,SAAU,CAAC,CAC3C,CAAEF,IAAI,CAAE,MAAM,CAAEC,GAAG,CAAE,GAAG,CAAEC,GAAG,CAAE,SAAU,CAAC,CAC1C,CAAEF,IAAI,CAAE,SAAS,CAAEC,GAAG,CAAE,EAAE,CAAEC,GAAG,CAAE,SAAU,CAAC,CAC5C,CAAEF,IAAI,CAAE,UAAU,CAAEC,GAAG,CAAE,CAAC,CAAEC,GAAG,CAAE,SAAU,CAAC,CAC7C,CAED,KAAM,CAAAC,WAAW,CAAIF,GAAG,EAAK,CAC3BG,QAAQ,CAACC,eAAe,CAACC,KAAK,CAACC,WAAW,CAAC,aAAa,CAAEN,GAAG,CAAC,CAC9DO,YAAY,CAACC,OAAO,CAAC,aAAa,CAAER,GAAG,CAAC,CACxCH,SAAS,CAAC,KAAK,CAAC,CAClB,CAAC,CAED,mBACEH,IAAA,QAAKe,SAAS,CAAC,eAAe,CAAAC,QAAA,CAC3Bd,MAAM,eACLF,IAAA,QAAKe,SAAS,CAAC,qBAAqB,CAAAC,QAAA,CACjCZ,MAAM,CAACa,GAAG,CAAEC,KAAK,eAChBlB,IAAA,WAEEe,SAAS,CAAC,qBAAqB,CAC/BJ,KAAK,CAAE,CAAEQ,eAAe,CAAED,KAAK,CAACX,GAAI,CAAE,CACtCa,OAAO,CAAEA,CAAA,GAAMZ,WAAW,CAACU,KAAK,CAACZ,GAAG,CAAE,CACtCe,KAAK,CAAEH,KAAK,CAACb,IAAK,CAAAW,QAAA,cAElBhB,IAAA,SAAMe,SAAS,CAAC,wBAAwB,CAAAC,QAAA,CAAEE,KAAK,CAACb,IAAI,CAAO,CAAC,EANvDa,KAAK,CAACZ,GAOL,CACT,CAAC,CACC,CACN,CACE,CAAC,CAEV,CA