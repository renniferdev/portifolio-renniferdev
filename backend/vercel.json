{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "index.js"
    }
  ],
  "env": {
    "GMAIL_USER": "@gmail_user",
    "GMAIL_PASSWORD": "@gmail_password",
    "GMAIL_FROM_NAME": "@gmail_from_name",
    "GMAIL_RECIPIENT_EMAIL": "@gmail_recipient_email"
  }
}
